{
  "version": 1,
  "repositories": {
    "public": { "name": "RauPro/MDH-SV", "visibility": "public" },
    "private": { "name": "RauPro/MDH-SV-review", "visibility": "private" }
  },
  "actions": {
    "enabled": true,
    "sha_pinning_required": true,
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "public_main_protection": {
    "file": ".github/main-protection.json",
    "enforce_admins": true,
    "restrictions": null
  },
  "private_main_protection": {
    "protected": false,
    "status": "accepted",
    "reason": "Private workflows write runtime state to main through the contents API (for example runtime/gemini-hourly.json via apps/pipeline/src/mdh_pipeline/review_queue.py), so classic branch protection would block the bots."
  },
  "variables": {
    "MDH_AUTOMATION_ENABLED": { "repositories": ["public", "private"], "equals": "true" },
    "GEMINI_MODEL": { "repositories": ["private"], "present": true },
    "MDH_GEMINI_BUDGET_CONFIG": { "repositories": ["private"], "budget_check": true }
  },
  "schedule_delay_tolerance_hours": 8
}
