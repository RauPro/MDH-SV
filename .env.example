# Optional LOCAL candidate collection; never needed for the public web.
MDH_ENABLE_INGESTION=0
MDH_ENABLE_AI=0
MDH_CANDIDATE_DB=.local-quarantine/candidates.sqlite
# Set only when intentionally sending public article text to Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional zero-cost fallback lanes for the PRIVATE queue only (see docs/GEMINI-REVIEW.md).
# A key is used only when MDH_LLM_FALLBACK_CONFIG names its provider and that
# provider's ledger was provisioned explicitly. Each one receives public article text.
GROQ_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
